rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Product images uploaded from admin panel
    match /products/{imageFile} {
      // Anyone can view/download product images (needed for the shop)
      allow read: if true;

      // Only signed-in admin can upload or delete
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024      // max 5 MB
                   && request.resource.contentType.matches('image/.*'); // images only
    }

    // Block everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
