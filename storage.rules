// ═══════════════════════════════════════════════════════════════
// NOVIA — Firebase Storage Security Rules
// ═══════════════════════════════════════════════════════════════
//
// HOW TO DEPLOY:
//   Firebase Console → Storage → Rules tab → paste & Publish
//   OR: firebase deploy --only storage
//
// WHAT THESE RULES DO:
//   ✅ Anyone can READ/download images (needed for product photos)
//   🔒 Only authenticated admins can UPLOAD or DELETE images
// ═══════════════════════════════════════════════════════════════

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Product images folder ────────────────────────────────────
    match /products/{imageFile} {
      // Anyone can view product images
      allow read: if true;

      // Only signed-in admin can upload or delete
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024   // max 5 MB
                   && request.resource.contentType.matches('image/.*'); // images only
    }

    // ── Deny all other paths ─────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
